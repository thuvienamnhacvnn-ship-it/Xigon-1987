{
  "name": "xigon1987",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3060",
    "build": "next build",
    "start": "next start -p 3060",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "assets": "node scripts/build-assets.mjs",
    "db:reset": "node -e \"require('fs').rmSync('.data/pg',{recursive:true,force:true});require('fs').mkdirSync('.data/pg',{recursive:true})\" && npm run db:migrate && npm run db:seed",
    "smoke": "tsx --tsconfig tsconfig.scripts.json scripts/smoke.ts",
    "qr": "node scripts/build-qr.mjs",
    "map": "node scripts/build-map.mjs",
    "admin:unlock": "tsx --tsconfig tsconfig.scripts.json scripts/unlock-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
